.DS_Store
**/.DS_Store
*.swp
*.swo
.idea/
.vscode/
node_modules/

# Claude Code runtime — never commit
**/.claude/.session-state/
**/.claude/hook-runs.jsonl
**/.claude/review-log/*.jsonl
.mcp.json
.env
.secrets

# v0.3: plugin repo itself uses .claude/ only for session logs — ignore by
# default. v0.9.3 (#47 sub-3): use the .claude/* pattern (NOT .claude/) so
# !.claude/tests/ unignore actually takes effect — gitignore can't re-include
# children of a directory-form ignore, but it CAN re-include children of a
# pattern-form ignore. Reference: gitignore(5) — "It is not possible to
# re-include a file if a parent directory of that file is excluded."
.claude/*

# Re-include .claude/tests/ — bats tests for plugin's own scripts live here
# so scripts/test.sh + bats-gate.sh can discover them at their conventional
# path. The !.claude/tests/ + !.claude/tests/** pair lets git recurse into
# the tests dir while leaving the rest of .claude/ ignored.
!.claude/tests/
!.claude/tests/**

# Re-include .claude/.source-hashes.json — SSOT manifest for consumer
# hash-drift.sh --verify (#140 — Sub 2 of #138). Must be committed
# alongside source so each release pins a verifiable content baseline.
!.claude/.source-hashes.json

# Re-include .claude/log-retention.yml — SSOT for log/state retention (#250),
# read by scripts/maintain/log-retention.sh at runtime + propagated to consumers
# by bootstrap-repo.sh. Must be tracked so a fresh clone has it (else
# log-retention.sh exits 2 on the missing SSOT — the bug #250 fixes).
!.claude/log-retention.yml
